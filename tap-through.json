{
  "app": "KeepMyProof",
  "brand": "keepmyproof",
  "about": "The app's own robot walk for every PR that changes a screen (boss-os scripts/ops/tap-through.mjs, ship-ready app-review.md). Sample papers and test values only; the web preview keeps nothing, so nothing real is touched.",
  "journeys": [
    {
      "name": "first-run",
      "start": "/",
      "steps": [
        {
          "sweep": true
        },
        {
          "tap": "Continue in English ›",
          "then": "Choose a passcode for this app",
          "id": "passcode"
        },
        {
          "fill": "Passcode",
          "value": "135790"
        },
        {
          "fill": "Enter the same six numbers again",
          "value": "135790"
        },
        {
          "tap": "Save passcode ›",
          "then": "Your 12-word recovery phrase",
          "id": "recovery-words"
        },
        {
          "tap": "I've written them down ›",
          "then": "Type your 12 words to confirm",
          "id": "confirm-words"
        },
        {
          "fill": "12 words, separated by spaces",
          "value": "test words that are not the twelve shown"
        },
        {
          "tap": "Go to Home ›",
          "then": "Those words did not match. Check all 12 words and their order.",
          "id": "words-refused"
        }
      ]
    },
    {
      "name": "restore-backup",
      "start": "/",
      "steps": [
        {
          "tap": "Restore a backup ›",
          "id": "restore"
        },
        {
          "sweep": true
        }
      ]
    },
    {
      "name": "main-task",
      "start": "/",
      "steps": [
        {
          "tap": "Preview only: skip to a sample vault ›",
          "then": "/Divorce, custody or co-parenting log/"
        },
        {
          "tap": "/Divorce, custody or co-parenting log/",
          "then": "Joint checking statements, Jan to Jun",
          "id": "folder"
        },
        {
          "tap": {
            "role": "button",
            "name": "Open ›"
          },
          "then": "Make a PDF of this item ›",
          "id": "detail"
        },
        {
          "tap": "Make a PDF of this item ›",
          "then": "/^1 of \\d+ items ticked/",
          "id": "item-pdf"
        }
      ]
    },
    {
      "name": "paywall",
      "start": "/",
      "steps": [
        {
          "tap": "Preview only: skip to a sample vault ›",
          "then": "/Divorce, custody or co-parenting log/"
        },
        {
          "tap": "See Plus ›",
          "then": "KeepMyProof Plus",
          "id": "plans"
        },
        {
          "tap": "Restore purchases ›",
          "then": "No active Plus purchase was found. Your papers remain available.",
          "id": "restore-purchase"
        },
        {
          "tap": "Not now",
          "then": "/^Free plan: \\d+ of 25 items used\\./"
        }
      ]
    },
    {
      "name": "plus-member",
      "start": "/?plus=1",
      "steps": [
        {
          "tap": "Preview only: skip to a sample vault ›",
          "then": "/^\\d+ items · Plus/",
          "id": "home-plus"
        },
        {
          "tap": "Settings"
        },
        {
          "tap": "See Plus ›",
          "then": "✓ Plus is on.",
          "id": "plus-on"
        },
        {
          "tap": "← Back to Home"
        },
        {
          "tap": "/Divorce, custody or co-parenting log/",
          "then": "Joint checking statements, Jan to Jun"
        },
        {
          "tap": "+ Add something",
          "then": "Tags (separated by commas)",
          "id": "unlimited"
        },
        {
          "fill": "Name it",
          "value": "TEST note with a tag"
        },
        {
          "fill": "Tags (separated by commas)",
          "value": "TEST tag",
          "id": "tags"
        },
        {
          "tap": "/^Save to /",
          "then": "Show only a tag",
          "id": "tag-filter"
        },
        {
          "tap": "Make a PDF of this folder ›"
        },
        {
          "tap": "/Choose dates and a cover page/",
          "then": "From (optional)",
          "id": "range-pdf"
        }
      ]
    },
    {
      "name": "own-folder",
      "start": "/?plus=1",
      "steps": [
        {
          "tap": "Preview only: skip to a sample vault ›",
          "then": "/Divorce, custody or co-parenting log/"
        },
        {
          "tap": "/^Make your own folder/",
          "then": "Folder name",
          "id": "own-folder"
        },
        {
          "fill": "/folder name/i",
          "value": "Test folder"
        },
        {
          "tap": "/^Create/",
          "then": "Dated and organized, ready to share when you need to.",
          "id": "own-folder-made"
        }
      ]
    },
    {
      "name": "delete-my-data",
      "start": "/",
      "steps": [
        {
          "tap": "Preview only: skip to a sample vault ›",
          "then": "/Divorce, custody or co-parenting log/"
        },
        {
          "tap": "Settings",
          "then": "Folders on Home",
          "id": "settings"
        },
        {
          "sweep": true
        },
        {
          "tap": "Erase everything on this device…",
          "then": "Erase everything on this device",
          "id": "erase"
        },
        {
          "fill": "Type your passcode to erase",
          "value": "123456"
        },
        {
          "tap": "Erase everything",
          "then": "Everything on this device was erased.",
          "id": "erased"
        }
      ]
    }
  ],
  "promises": [
    {
      "text": "Unlimited items",
      "on": "paywall:plans",
      "built": "plus-member:unlimited"
    },
    {
      "text": "Your own folders",
      "on": "paywall:plans",
      "built": "own-folder:own-folder-made"
    },
    {
      "text": "Tags on any item, and a tag filter in each folder",
      "on": "paywall:plans",
      "built": "plus-member:tag-filter"
    },
    {
      "text": "PDF of a date range, with a cover page",
      "on": "paywall:plans",
      "built": "plus-member:range-pdf"
    },
    {
      "text": "Restore purchases ›",
      "on": "paywall:plans",
      "built": "paywall:restore-purchase"
    }
  ],
  "native_only": [
    {
      "feature": "in-app purchase",
      "why": "the web preview has no App Store or Play Billing; Buy buttons are off and say so. ?plus=1 shows the paid screens instead.",
      "simulator": "the Simulator preview workflow (preview.yml, Maestro walk) on a free macOS runner, with a sandbox account for the purchase itself"
    },
    {
      "feature": "camera and photo library",
      "why": "Choose a photo adds two sample pictures in a browser",
      "simulator": "preview.yml Maestro walk"
    },
    {
      "feature": "Face ID",
      "why": "the browser stand-in always says yes",
      "simulator": "preview.yml Maestro walk"
    }
  ]
}
