{
  "name": "keepmyproof",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --offline",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "validate": "node scripts/validate.mjs",
    "check": "npm run typecheck && npm test && npm run validate",
    "release-gate": "node scripts/release-gate.mjs",
    "eas-build-pre-install": "node scripts/release-gate.mjs --if-production",
    "bundle": "expo export --platform ios --platform android"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "@scure/bip39": "2.4.0",
    "expo": "58.0.22",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-local-authentication": "~58.0.2",
    "expo-localization": "~58.0.5",
    "expo-print": "~58.0.8",
    "expo-router": "~58.0.29",
    "expo-screen-capture": "~58.0.6",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-sqlite": "~58.0.15",
    "fflate": "0.8.3",
    "pdf-lib": "1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-purchases": "11.0.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3"
  }
}
